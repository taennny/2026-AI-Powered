# .env.example — 이 파일은 git에 올라갑니다 (키 값 없이 형식만 공유)
# 실제 키는 팀 내부 채널에서 공유받아 .env 파일에 입력하세요

# 로컬 백엔드로 붙을 때는 http://localhost:8000
# 맨 끝에 슬래시 붙이지 말기 (카카오 redirect_uri가 등록값과 한 글자라도 다르면 로그인 자체가 막힘)
EXPO_PUBLIC_API_BASE_URL=https://api.roame.co.kr

# 백그라운드 GPS. Expo Go로 실행하려면 false, 시뮬레이터 빌드·배포는 true
EXPO_PUBLIC_BG_GPS=false

EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here


EXPO_PUBLIC_KAKAO_REST_API_KEY=fe4f73594264f90fbda73e9847a0c218
EXPO_PUBLIC_KAKAO_REDIRECT_URI=https://api.roame.co.kr/api/v1/auth/kakao/callback
