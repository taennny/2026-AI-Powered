# 카카오 로컬 API (AI-1 국내 장소 매칭)
KAKAO_API_KEY=your_kakao_rest_api_key_here

# 구글 Places API (AI-1 해외 장소 매칭 — 국내 카카오 / 해외 구글 하이브리드)
# 미설정 시 해외 좌표는 "알 수 없음" 처리(국내 동작엔 영향 없음)
GOOGLE_MAPS_API_KEY=your_google_places_api_key_here

# OpenAI (AI-3 블로그 생성)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 서버 포트 (백엔드 AI_SERVER_URL 과 일치)
PORT=5000
