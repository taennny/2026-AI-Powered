# Database
DB_USER=roame
DB_PASSWORD=roame1234
DB_NAME=roame
# 프로덕션에서는 강한 랜덤 비밀번호로 교체할 것
# DATABASE_URL은 compose가 DB_USER/DB_PASSWORD/DB_NAME으로 조합하므로 별도 지정 불필요
SQL_ECHO=false
# 프로덕션에서는 false

# MinIO (S3 호환 스토리지)
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=roame-photos
# presigned URL 공개 주소 — 운영: https://api.roame.co.kr / 로컬: 빈 값(내부 주소 서명)
MINIO_PUBLIC_ENDPOINT=

# JWT
# 프로덕션에서는 `openssl rand -hex 32` 등으로 생성한 랜덤 값 사용
JWT_SECRET_KEY=change-this-to-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Server
AI_SERVER_URL=

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
