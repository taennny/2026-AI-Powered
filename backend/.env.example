# Database
DB_USER=roame
DB_PASSWORD=roame1234
DB_NAME=roame
# 프로덕션에서는 강한 랜덤 비밀번호로 교체할 것
# DATABASE_URL은 compose가 DB_USER/DB_PASSWORD/DB_NAME으로 조합하므로 별도 지정 불필요
SQL_ECHO=false
# 프로덕션에서는 false

# MinIO (S3 호환 스토리지)
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=roame-photos
# presigned URL 공개 주소 — 운영: https://api.roame.co.kr / 로컬: 빈 값(내부 주소 서명)
MINIO_PUBLIC_ENDPOINT=

# JWT
# 필수. 비워두거나 예시 기본값이면 서버가 기동을 거부한다.
# 생성: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Server
AI_SERVER_URL=

# RevenueCat 웹훅
# 대시보드 Webhooks 설정의 Authorization 값과 동일하게 (랜덤 생성, 레포·팀 채팅 금지)
REVENUECAT_WEBHOOK_SECRET=
# 이벤트 environment 필터 기준: PRODUCTION | SANDBOX (불일치 이벤트는 저장만)
REVENUECAT_ENVIRONMENT=PRODUCTION

# 생성 쿼터
# 무료 사용자 주간 AI 생성 한도 (프리미엄은 무제한)
FREE_WEEKLY_BLOG_LIMIT=3
# 하루 경계(새벽 4시). 주 리셋도 이 시각 기준 — 월요일 04:00 KST
DAY_BOUNDARY_HOUR=4
# 한 편으로 묶을 수 있는 최대 일수(모아쓰기). 회의 미확정이라 넉넉히 잡음
MAX_BLOG_PERIOD_DAYS=31

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=

# 베타 기간 전원 프리미엄. true면 결제 없이 모든 사용자가 프리미엄 기능을 쓴다.
# DB는 바뀌지 않으므로 false로 되돌리면 즉시 원래 구독 상태로 돌아온다.
# 정식 출시 전 반드시 false 확인.
BETA_ALL_PREMIUM=false
